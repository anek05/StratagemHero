@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject StratagemClient Client
@using static StrataHero.Tools.Helpers;

<PageTitle>Home</PageTitle>
<button @onclick="FocusInputField">Start</button>
<input id="keyCaptureElement" @ref="keyCaptureElementRef" type="text" @onkeydown="DetectKeyPress" />
<div class="contents">
    @* @for (int i = 0; i < codeList[stratagemIndex].Length; i++)
    {
        var character = codeList[stratagemIndex][i];
        <i class="me-2 @(GetCssClass(i))">@character</i>
    } *@
    <div class="game">
    @if(Stratagem is not null)
    {
        <div class="">            
            <div class="iconrow">
                <img src="StratagemIcons/@Stratagem.Image" alt="@Stratagem.Name" class="stratagem-image " width="128" height="128" />
                <img src="StratagemIcons/@StratagemList[stratagemIndex+1].Image" alt="@Stratagem.Name" class="" width="128" height="128" />
                <img src="StratagemIcons/@StratagemList[stratagemIndex+2].Image" alt="@Stratagem.Name" class="" width="128" height="128" />
                <img src="StratagemIcons/@StratagemList[stratagemIndex+3].Image" alt="@Stratagem.Name" class="" width="128" height="128" />
                <img src="StratagemIcons/@StratagemList[stratagemIndex+4].Image" alt="@Stratagem.Name" class="" width="128" height="128" />
                <img src="StratagemIcons/@StratagemList[stratagemIndex+5].Image" alt="@Stratagem.Name" class="" width="128" height="128" />
            </div>
            <p class="text-center text-dark fw-semibold" style="background-color: #fee800;">@Stratagem.Name</p>
            <div class="sequence">
            @for(int i = 0; i < Stratagem.Sequence.ToCharArray().Length; i++)
            {
                @* <img src="Arrows/@(Stratagem.Sequence.ToCharArray()[i]).png" id="arrow-@i" alt="@Stratagem.Name" width="24" height="24"/> *@
                <StratagemArrow ArrowType="@Stratagem.Sequence.ToCharArray()[i]"
                    Alt="@Stratagem.Name"
                    Index="@i"
                     />
            }
            </div>
        </div>
        
    }

        <p>Score: @score</p>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width:@progress" aria-valuenow="@timeLeft" aria-valuemin="0" aria-valuemax="100">@timeLeft</div>
        </div
    </div>
</div>

@code {
    private ElementReference keyCaptureElementRef;

    private List<Stratagem>? StratagemList;
    private Stratagem? Stratagem = new();
    private List<StratagemArrow> arrowComponents = new List<StratagemArrow>();

    int score = 0;
    int stratagemIndex = 0;
    int charIndex = 0;

    string arrowStyle = String.Empty;
    bool isCorrect = false;
    Dictionary<int, bool> correctStatus = new Dictionary<int, bool>();

    //Timer variables
    private int timeLeft = 10; // Total countdown time in seconds
    private int totalTime = 10;
    private string progress = "100%";
    private bool isRunning = false;
    private System.Timers.Timer? timer;
    //**********************************//

    protected override void OnInitialized()
    {
        StratagemList = Client.GetStratagems();
        GetStratagem(stratagemIndex);
    }

    //Game starts
    private async Task FocusInputField()
    {
        await keyCaptureElementRef.FocusAsync();
        StratagemList.Shuffle();
        await StartTimer();
    }

    private void GetStratagem(int stratagemIndex)
    {
        Stratagem.Name = StratagemList[stratagemIndex].Name;
        Stratagem.Sequence = StratagemList[stratagemIndex].Sequence;
        Stratagem.Image = StratagemList[stratagemIndex].Image;
    }


    private async Task DetectKeyPress(KeyboardEventArgs e)
    {
        var sequenceArray = Stratagem.Sequence.ToCharArray();
        if(InputMapper(e.Key.ToUpper()) == sequenceArray[charIndex])
        {
            await ChangeArrowClass(charIndex, "highlighted");
            charIndex++;
            @*arrowStyle = "filter: grayscale(1);";*@
            if(charIndex == sequenceArray.Length)
            {
                charIndex = 0;
                stratagemIndex++;
                score += 10;
                timeLeft += 5;
                GetStratagem(stratagemIndex);
                await ResetArrowClass(Stratagem.Sequence.ToCharArray()); //new stratagem so can't use sequenceArray, fix this
            }
        }
        else
        {
            charIndex = 0;
            await ResetArrowClass(sequenceArray);
        } 
        StateHasChanged(); 
    }

    ///<summary>
    /// Maps the user input so it maps the stratagem sequence characters.
    //  'E' stands for "Error"
    ///<summary>
    private char InputMapper(string input)
    {
        switch(input)
        {
            case "W":
                return 'U';
            case "S":
                return 'D';
            case "A":
                return 'L';
            case "D":
                return 'R';
            default:
                return 'E';
        }
    } 

    // Method to change a specific arrow's class
    public async Task ChangeArrowClass(int index, string newClass)
    {
        /*if (index >= 0)
        {
            await arrowComponents[index].SetClass(newClass);
        }*/
        string className = $"stratagem-arrow {newClass}";
        // Use JavaScript interop to immediately update the class in the DOM
        // This ensures the change is visible even if Blazor hasn't re-rendered yet
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('arrow-{index}').className = '{className}'");
        StateHasChanged();
    }

    public async Task ResetArrowClass(char[] sequence)
    {
        for(int i = 0; i < sequence.Length; i++)
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('arrow-{i}').className = 'stratagem-arrow'");
            StateHasChanged();
        }
    }

    //Timer*******************************

    private async Task StartTimer()
    {
        isRunning = true;
        timeLeft = totalTime;
        UpdateProgressBar();

        timer = new System.Timers.Timer(1000); // Set the timer interval to 1 second
        timer.Elapsed += OnTimerElapsed;
        timer.AutoReset = true;
        timer.Enabled = true;
    }

    private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (timeLeft > 0)
        {
            timeLeft--;
            UpdateProgressBar();
            InvokeAsync(StateHasChanged); // Refresh UI
        }
        else
        {
            timer?.Stop();
            isRunning = false;
            InvokeAsync(StateHasChanged); // Refresh UI
        }
    }

    private void UpdateProgressBar()
    {
        double newProgress = ((double)timeLeft / totalTime * 100);
        if (newProgress > 100)
        {
            newProgress = 100;
            progress = (newProgress).ToString("F0") + "%";
        }
        progress = (newProgress).ToString("F0") + "%";
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
    //Timer end*******************************
}
